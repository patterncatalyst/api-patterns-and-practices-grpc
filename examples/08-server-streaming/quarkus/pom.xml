<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ch8 server-streaming example — Quarkus side.

  Implements shipping.tracking.v1.TrackingService.WatchShipment (the
  server-streaming RPC) from the shared proto contract in contracts/proto/.
  Only WatchShipment has a real implementation; ReportPositions (client
  streaming) and Sync (bidirectional) return UNIMPLEMENTED — both land in
  Chapter 9.

  The *.proto files are NOT committed under src/main/proto/ in this module —
  contracts/proto/ is the single source of truth. The Containerfile COPYs
  the two proto files this service needs into src/main/proto/ as part of the
  image build (see Containerfile), where the quarkus-grpc extension's
  code-generation picks them up automatically. For a local, non-container
  `mvn package`, run the copy by hand first (see README.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.patterncatalyst.shipping</groupId>
  <artifactId>ch08-quarkus-sstream</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <!-- `quarkus` packaging (not plain `jar`) binds proto code generation to
       the generate-sources phase, before compile — see Ch5/Ch7's modules
       for the same note. -->
  <packaging>quarkus</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.40.1</quarkus.platform.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Generates the Mutiny TrackingService interface (watchShipment returns
         Multi<WatchShipmentResponse>) from src/main/proto/**.proto at build
         time; no separate protoc/protobuf-maven-plugin configuration needed. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-grpc</artifactId>
    </dependency>
    <!-- Automatically instruments the gRPC server, including server-streaming
         calls, so a WatchShipment call produces a span once an OTLP endpoint
         is reachable (the opt-in `observability` compose profile). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-opentelemetry</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
