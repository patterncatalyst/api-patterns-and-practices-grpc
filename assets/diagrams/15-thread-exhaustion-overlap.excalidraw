   "versionNonce": 1374815617,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "blocks its OWN worker thread independently --",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "blocks its OWN worker thread independently --",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
