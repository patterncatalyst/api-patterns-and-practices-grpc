<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ch4 well-known-types ANCHOR — Quarkus side.

  Implements shipping.routing.v1.RoutingService.FindOptimalRoute, the one RPC
  this chapter needs to teach google.protobuf.Timestamp and the Money
  decimal-string convention over the wire. The other four methods declared on
  RoutingService (GetQuote, ListRoutes, NegotiateRoute, RecomputeRoutes)
  return UNIMPLEMENTED — this example is independent of Chapter 5's
  GetQuote anchor, not an extension of it.

  The *.proto files are NOT committed under src/main/proto/ in this module —
  contracts/proto/ is the single source of truth. The Containerfile COPYs the
  two proto files this service needs into src/main/proto/ as part of the
  image build, where the quarkus-grpc extension's code generation picks them
  up automatically. For a local, non-container `mvn package`, run the copy by
  hand first (see README.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.patterncatalyst.shipping</groupId>
  <artifactId>ch04-quarkus-wkt</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <!-- `quarkus` packaging (not plain `jar`) binds the quarkus-grpc extension's
       proto-to-Mutiny code generation to generate-sources, before compile —
       see Chapter 5's pom.xml for the full explanation of why this matters. -->
  <packaging>quarkus</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <!-- Quarkus latest stable LTS (3.40.x, released Sept 2026) — matches the
         sibling Chapter 5 example's pin. -->
    <quarkus.platform.version>3.40.1</quarkus.platform.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Generates Mutiny stubs from src/main/proto/**.proto at build time,
         including the compiled Java classes for every well-known type this
         chapter uses (com.google.protobuf.Timestamp ships inside protobuf-java
         itself — no extra dependency needed to build one). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-grpc</artifactId>
    </dependency>
    <!-- Automatically instruments the gRPC server so FindOptimalRoute calls
         produce spans once an OTLP endpoint is reachable (the opt-in
         `observability` compose profile). Fails soft with no collector. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-opentelemetry</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
