# Protos copied from contracts/ into each service module for local `mvn`/
# `uv` runs outside Docker (the Containerfiles do the same copy inside the
# build context). contracts/proto/ stays the single source of truth; these
# copies are build-time-only and never committed.
quarkus/src/main/proto/
python/generated/
loadclient/generated/

# certgen's host-bind export: a fresh CA/client cert/key dropped here on
# every verify.sh run so the host-side grpcurl/ghz binaries can present
# them. Never committed — regenerated on every run, local key material only.
.host-out/

# Byte-compiled artifacts from any host-side `python3` run (loadclient,
# mint_token, etc.) outside the container build.
__pycache__/
*.pyc
__pycache__/
*.pyc
scripts/.bin/
*.tar.gz
