   "text": "Every call starts at roughly the same moment and",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every call starts at roughly the same moment and",
   "lineHeight": 1.25,
   "baseline": 14
  },
  {
   "id": "t59173396",
   "type": "text",
   "x": 240,
   "y": 378,
   "width": 272.25,
   "height": 13.75,
