<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ch13 schema-design ANCHOR — Quarkus side.

  Implements shipping.routing.v1.RoutingService.ListRoutes: a small in-memory
  catalog of Routes, paginated with page_size/page_token, projected with a
  google.protobuf.FieldMask. The other four RoutingService RPCs return
  UNIMPLEMENTED, same discipline as every prior chapter's example.

  The *.proto files are NOT committed under src/main/proto/ in this module —
  contracts/proto/ is the single source of truth. The Containerfile COPYs
  the two proto files this service needs into src/main/proto/ as part of the
  image build, where the quarkus-grpc extension's code-generation picks them
  up automatically. For a local, non-container `mvn package`, run the copy
  by hand first (see README.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.patterncatalyst.shipping</groupId>
  <artifactId>ch13-quarkus-schema-design</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <!-- `quarkus` packaging (not plain `jar`) binds the quarkus-grpc extension's
       proto-to-Mutiny code generation to the generate-sources phase, before
       compile — same reason as every prior anchor. -->
  <packaging>quarkus</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <!-- Matches every prior anchor's pin: Quarkus latest stable LTS (3.40.x). -->
    <quarkus.platform.version>3.40.1</quarkus.platform.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Generates Mutiny stubs from src/main/proto/**.proto at build time
         and runs the gRPC server. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-grpc</artifactId>
    </dependency>
    <!-- com.google.protobuf.util.FieldMaskUtil — the merge/normalize/isValid
         helpers this chapter's ListRoutes uses to project a Route by the
         request's FieldMask. Version-managed by the Quarkus BOM (4.35.0 as
         of 3.40.1), so no explicit version here. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java-util</artifactId>
    </dependency>
    <!-- BadRequest (Ch11's rich-error detail type), reused here for an
         invalid page_token or an unrecognized field_mask path. Not managed
         by the Quarkus BOM, so pinned here directly, same pin as Ch11. -->
    <dependency>
      <groupId>com.google.api.grpc</groupId>
      <artifactId>proto-google-common-protos</artifactId>
      <version>2.71.0</version>
    </dependency>
    <!-- Automatically instruments the gRPC server so ListRoutes calls produce
         spans once an OTLP endpoint is reachable (the opt-in `observability`
         compose profile). Fails soft with no collector listening. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-opentelemetry</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
