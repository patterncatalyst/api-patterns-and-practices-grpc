# Ch21 observability ANCHOR — Python, UBI 10, uv-managed, grpc.aio server +
# a FastAPI/uvicorn REST front door, in one process.
# Build (from the REPO ROOT, so this context can reach contracts/):
#   docker build -f examples/21-observability/python/Containerfile \
#     -t ch21-observability-python .
# compose.yaml sets the build context to the repo root for exactly this
# reason — contracts/proto/ is the single source of truth for the .proto
# files, and this build COPIES the three files this module needs into a
# proto/ staging directory, then runs `python -m grpc_tools.protoc` to
# generate the shipping.* stub packages the app imports (types, routing, AND
# quote — this one process implements both RoutingService and QuoteService,
# and also dials RoutingService as a client from the REST layer; see
# app/main.py). The copy and the generated stubs are build-time only —
# neither is committed (see ../.gitignore).
#
# Pin refreshed at authoring time past every prior anchor's
# 10.2-1791464217 pin (re-check with
# `skopeo list-tags docker://registry.access.redhat.com/ubi10/python-314-minimal`,
# confirm with `skopeo inspect`; bump deliberately):
#   registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791928506

# ── Stage 1: Build ──────────────────────────────────────────
FROM registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791928506 AS build

# The image runs as UID 1001; the build stage needs root to write /app.
# Build at the same path the runtime uses: a venv is not relocatable, its
# console scripts carry the absolute interpreter path.
USER 0
WORKDIR /app

RUN pip install --no-cache-dir uv==0.12.24

COPY examples/21-observability/python/pyproject.toml ./
COPY examples/21-observability/python/app ./app

# No uv.lock committed yet (small, pure-Python dependency set); --locked is
# adopted once a lockfile lands alongside a persistence layer.
# `--group dev` pulls in grpcio-tools (needed below, not at runtime).
RUN uv sync --group dev

# Stage the three proto files this module needs, preserving the package
# paths routing.proto's and quote.proto's import statements expect, then
# generate the stub packages into /app/generated — a sibling of app/, added
# to PYTHONPATH below, so `from shipping.routing.v1 import routing_pb2` and
# `from shipping.quote.v1 import quote_pb2` resolve the same way they do
# after a local (non-container) `protoc` run.
COPY contracts/proto/shipping/type/v1/types.proto ./proto/shipping/type/v1/types.proto
COPY contracts/proto/shipping/routing/v1/routing.proto ./proto/shipping/routing/v1/routing.proto
COPY contracts/proto/shipping/quote/v1/quote.proto ./proto/shipping/quote/v1/quote.proto
RUN mkdir -p generated && \
    .venv/bin/python -m grpc_tools.protoc -I proto \
      --python_out=generated --grpc_python_out=generated \
      proto/shipping/type/v1/types.proto proto/shipping/routing/v1/routing.proto proto/shipping/quote/v1/quote.proto

# Rebuild the venv without the dev group (grpcio-tools and its protoc
# binary are not needed to run the server or the REST front door).
RUN rm -rf .venv && uv sync --no-dev

# ── Stage 2: Runtime ────────────────────────────────────────
FROM registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791928506

WORKDIR /app

COPY --from=build --chown=1001:0 /app/.venv /app/.venv
COPY --from=build --chown=1001:0 /app/app /app/app
COPY --from=build --chown=1001:0 /app/generated /app/generated

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/generated:/app" \
    PYTHONUNBUFFERED=1 \
    GRPC_HOST=0.0.0.0 \
    GRPC_PORT=9000 \
    HTTP_HOST=0.0.0.0 \
    HTTP_PORT=8000 \
    OTEL_SERVICE_NAME=ch21-observability-python \
    OTEL_TRACES_EXPORTER=otlp \
    OTEL_METRICS_EXPORTER=none \
    OTEL_LOGS_EXPORTER=none \
    OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317 \
    OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=false

EXPOSE 9000 8000
USER 1001

# opentelemetry-instrument is a zero-code wrapper: it auto-instruments the
# grpc.aio server, the grpc.aio client channel (both RoutingServiceServicer's
# downstream call AND the REST handler's call into RoutingService), and the
# FastAPI app (via opentelemetry-instrumentation-fastapi's patch of
# fastapi.FastAPI.__init__), and exports spans to OTEL_EXPORTER_OTLP_ENDPOINT.
# When no collector is listening there, the OTLP exporter just logs failed
# exports in the background — the server still starts and serves requests.
ENTRYPOINT ["opentelemetry-instrument", "python", "-m", "app.main"]
