<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ch9 client-and-bidi-streaming — Quarkus side.

  Implements shipping.tracking.v1.TrackingService.ReportPositions (client
  streaming) and .Sync (bidirectional streaming) from the shared proto
  contract in contracts/proto/. Only these two RPCs have a real
  implementation; WatchShipment (server streaming, Ch8's RPC) returns
  UNIMPLEMENTED here — one service, one chapter's two new shapes, kept to
  one service for a reliable both-stack build.

  The *.proto files are NOT committed under src/main/proto/ in this module —
  contracts/proto/ is the single source of truth. The Containerfile COPYs
  the two proto files this service needs into src/main/proto/ as part of the
  image build (see Containerfile), where the quarkus-grpc extension's
  code-generation picks them up automatically. For a local, non-container
  `mvn package`, run the copy by hand first (see README.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.patterncatalyst.shipping</groupId>
  <artifactId>ch09-quarkus-client-bidi-streaming</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <!-- The `quarkus` packaging type (not plain `jar`) activates the custom
       Maven lifecycle that binds proto code generation to the
       generate-sources phase, before compile — this module generates Java
       sources from src/main/proto/**.proto. -->
  <packaging>quarkus</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <!-- Quarkus latest stable LTS (3.40.x) — matches the other example modules' pin. -->
    <quarkus.platform.version>3.40.1</quarkus.platform.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Generates Mutiny stubs from src/main/proto/**.proto at build time
         and runs the gRPC server; no separate protoc/protobuf-maven-plugin
         configuration needed — the quarkus-maven-plugin's `build` goal
         drives code generation from the quarkus-grpc extension. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-grpc</artifactId>
    </dependency>
    <!-- Automatically instruments the gRPC server (quarkus.otel.instrument.grpc,
         on by default) so ReportPositions/Sync calls produce spans once an
         OTLP endpoint is reachable (the opt-in `observability` compose
         profile). The SDK's OTLP exporter fails soft when no collector is
         reachable, so the app starts fine without it. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-opentelemetry</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
