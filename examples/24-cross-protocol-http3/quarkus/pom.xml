<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ch24 cross-protocol-http3 — Quarkus side.

  Implements only shipping.routing.v1.RoutingService.GetQuote (the Ch7
  formula, unchanged) — this chapter's example is a lean server, with no
  ListRoutes catalog and no QuoteService/REST front door, because its
  subject is which transport a call travels over, not a new RPC. The other
  four RoutingService methods return UNIMPLEMENTED, same discipline as every
  prior chapter's example.

  The *.proto files are NOT committed under src/main/proto/ in this module —
  contracts/proto/ is the single source of truth. The Containerfile COPYs
  the two proto files this service needs into src/main/proto/ as part of the
  image build, where the quarkus-grpc extension's code generation picks them
  up automatically. For a local, non-container `mvn package`, copy the files
  by hand first (see README.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.patterncatalyst.shipping</groupId>
  <artifactId>ch24-quarkus-cross-protocol-http3</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <!-- `quarkus` packaging (not plain `jar`) binds the quarkus-grpc extension's
       proto-to-Mutiny code generation to the generate-sources phase, before
       compile — the same reason every prior anchor uses it. -->
  <packaging>quarkus</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <!-- Matches every prior anchor's pin: Quarkus latest stable LTS (3.40.x). -->
    <quarkus.platform.version>3.40.1</quarkus.platform.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Generates the Mutiny service interface + client stubs from
         src/main/proto/**.proto at build time, and runs the gRPC server
         over HTTP/2 — grpc-java (and so Quarkus) has no gRPC-over-HTTP/3
         transport to opt into as of this writing; see the chapter prose. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-grpc</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
