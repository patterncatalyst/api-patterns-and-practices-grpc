   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Same auth hook gates GetQuote (implemented) and the four UNIMPLEMENTED RoutingService methods alike: the interceptor doesn't know or care which handler is behind it.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Same auth hook gates GetQuote (implemented) and the four UNIMPLEMENTED RoutingService methods alike: the interceptor doesn't know or care which handler is behind it.",
