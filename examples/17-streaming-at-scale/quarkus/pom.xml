<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ch17 streaming-at-scale example — Quarkus side.

  Implements shipping.tracking.v1.TrackingService.WatchShipment as a
  DEMAND-DRIVEN live feed: a Multi built from Multi.createFrom().emitter(...),
  where MultiEmitter.onRequest(...) drives production — the next
  TrackingEvent is built and stamped with the server's production wall-clock
  only once the downstream subscriber (the generated gRPC bridge's
  ServerCallStreamObserver, wired via setOnReadyHandler) has asked for more.
  See TrackingServiceImpl.java. ReportPositions and Sync return
  UNIMPLEMENTED, same discipline as every prior chapter's anchor.

  Confirmed against the io.quarkus:quarkus-grpc:3.40.1 jar (decompiled
  GrpcServerConfiguration$GrpcServerNettyConfig): the server's keepalive
  knobs live under quarkus.grpc.server.netty.* (keep-alive-time,
  permit-keep-alive-time, permit-keep-alive-without-calls), applied via
  grpc-java's NettyServerBuilder under the default separate-server mode
  (quarkus.grpc.server.use-separate-server=true) — see application.properties.

  The *.proto files are NOT committed under src/main/proto/ in this module —
  contracts/proto/ is the single source of truth. The Containerfile COPYs
  the two proto files this service needs into src/main/proto/ as part of the
  image build, where the quarkus-grpc extension's code generation picks them
  up automatically. For a local, non-container `mvn package`, run the copy
  by hand first (see README.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.patterncatalyst.shipping</groupId>
  <artifactId>ch17-quarkus-streaming</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <!-- `quarkus` packaging (not plain `jar`) binds the quarkus-grpc extension's
       proto-to-Mutiny code generation to the generate-sources phase, before
       compile — same reason as every prior anchor. -->
  <packaging>quarkus</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <!-- Matches every prior anchor's pin: Quarkus latest stable LTS (3.40.x). -->
    <quarkus.platform.version>3.40.1</quarkus.platform.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Generates the Mutiny TrackingService interface (watchShipment returns
         Multi<Tracking.WatchShipmentResponse>) from src/main/proto/**.proto
         at build time, and runs the gRPC server whose keepalive knobs this
         chapter configures (see application.properties). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-grpc</artifactId>
    </dependency>
    <!-- Explicit (quarkus-grpc already pulls this in transitively, since the
         gRPC server itself runs on Vert.x): TrackingServiceImpl injects
         io.vertx.core.Vertx directly to pace each demand-driven emission with
         Vertx.setTimer, the non-blocking way to delay work on an event-loop
         application without parking a thread in Thread.sleep. Declared here
         rather than relied on transitively, per this project's house style. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-vertx</artifactId>
    </dependency>
    <!-- Automatically instruments the gRPC server, including the
         WatchShipment server-stream, so a call produces a span once an OTLP
         endpoint is reachable (the opt-in `observability` compose profile). -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-opentelemetry</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
