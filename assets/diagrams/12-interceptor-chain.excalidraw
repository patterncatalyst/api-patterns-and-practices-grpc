   "roundness": null,
   "seed": 1232574528,
   "versionNonce": 380415632,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Python: the resolved RpcMethodHandler's behavior function is wrapped the same way, cardinality-matched so NegotiateRoute's bidi stream works too.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Python: the resolved RpcMethodHandler's behavior function is wrapped the same way, cardinality-matched so NegotiateRoute's bidi stream works too.",
   "lineHeight": 1.25,
   "baseline": 11
  },
