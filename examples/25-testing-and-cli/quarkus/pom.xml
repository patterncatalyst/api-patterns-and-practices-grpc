<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ch25 testing-and-cli — Quarkus side.

  Implements all five shipping.routing.v1.RoutingService RPCs declared in
  the shared proto contract in contracts/proto/: GetQuote (the Ch7 unary
  anchor, real implementation, byte-for-byte the same formula) plus
  FindOptimalRoute, ListRoutes, NegotiateRoute, and RecomputeRoutes, which
  return UNIMPLEMENTED pending later chapters. quarkus-grpc generates
  RoutingService as a plain Java INTERFACE, not an abstract base class with
  default UNIMPLEMENTED bodies — every method must be overridden here or
  this class does not compile, which is why every RPC below has a body.

  This module's point is the test dependency below: quarkus-junit5 pulls in
  JUnit 5 and wires @QuarkusTest to boot the full application (including its
  gRPC server) for src/test/java/.../RoutingServiceTest.java, which injects
  a real @GrpcClient and calls GetQuote over an actual loopback gRPC
  connection. The Containerfile's build stage runs `mvn verify` — not
  `-DskipTests` — so this test gates the image build.

  The *.proto files are NOT committed under src/main/proto/ in this module —
  contracts/proto/ is the single source of truth. The Containerfile COPYs
  the two proto files this service needs into src/main/proto/ as part of the
  image build, where the quarkus-grpc extension's code generation picks them
  up automatically. For a local, non-container `mvn verify`, copy the files
  by hand first (see README.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.patterncatalyst.shipping</groupId>
  <artifactId>ch25-quarkus-testing-and-cli</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <!-- `quarkus` packaging (not plain `jar`) binds the quarkus-grpc extension's
       proto-to-Mutiny code generation to the generate-sources phase, before
       compile — the same reason Ch5's pom.xml uses it. -->
  <packaging>quarkus</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <quarkus.platform.version>3.40.1</quarkus.platform.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Generates the Mutiny service interface + client stubs from
         src/main/proto/**.proto at build time, and runs the gRPC server. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-grpc</artifactId>
    </dependency>
    <!-- Automatically instruments the gRPC server so GetQuote calls produce
         spans once an OTLP endpoint is reachable (the opt-in `observability`
         compose profile). Fails soft with no collector listening. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-opentelemetry</artifactId>
    </dependency>
    <!-- Test-scope only: JUnit 5 + @QuarkusTest, the thing this chapter is
         about. Pulls in the junit-jupiter-engine the Surefire plugin needs
         to discover and run RoutingServiceTest.java. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
