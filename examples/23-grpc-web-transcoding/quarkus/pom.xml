<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ch23 grpc-web & JSON/HTTP transcoding — Quarkus side.

  The Ch21 two-service loopback shape, reused nearly verbatim: RoutingServiceImpl
  calls DOWNSTREAM QuoteServiceImpl over a loopback @GrpcClient channel, both in
  this one process on port 9000, PLUS the same minimal quarkus-rest endpoint
  (BookingResource, POST /booking/quote on HTTP port 8080) that calls
  RoutingService.GetQuote over its OWN loopback @GrpcClient. This chapter's point
  is what sits IN FRONT of this exact server — Envoy's grpc_web and
  grpc_json_transcoder filters (see ../envoy/) — so this module adds nothing new
  of its own: no proto annotation, no new dependency, no contract change. Dropped
  relative to Ch21: the Micrometer/Prometheus metrics dependency and the response
  traceId field — this chapter is not about observability, and LGTM stays
  opt-in (../compose.yaml's `observability` profile) rather than the always-on
  stack Ch21 wires.

  The *.proto files are NOT committed under src/main/proto/ in this module —
  contracts/proto/ is the single source of truth. The Containerfile COPYs the
  three proto files this module needs into src/main/proto/ as part of the image
  build. For a local, non-container `mvn package`, copy the files by hand first
  (see README.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.patterncatalyst.shipping</groupId>
  <artifactId>ch23-quarkus-grpc-web-transcoding</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <!-- `quarkus` packaging (not plain `jar`) binds the quarkus-grpc extension's
       proto-to-Mutiny code generation to the generate-sources phase, before
       compile — same reason as every prior anchor. -->
  <packaging>quarkus</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
    <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
    <!-- Matches every prior anchor's pin: Quarkus latest stable LTS (3.40.x). -->
    <quarkus.platform.version>3.40.1</quarkus.platform.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>${quarkus.platform.artifact-id}</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Generates the Mutiny service interface + client stubs from
         src/main/proto/**.proto at build time, runs the gRPC server, and
         registers the built-in grpc.health.v1.Health service automatically
         for every @GrpcService bean. Server reflection (enabled below) is
         what both grpcurl (native path) and Envoy's descriptor-free startup
         are NOT relying on here — the transcoder gets its schema from the
         baked-in descriptor, not reflection; grpcurl against the APP port
         still needs it. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-grpc</artifactId>
    </dependency>
    <!-- The REST front door: POST /booking/quote — the hand-written shim this
         chapter contrasts against Envoy's generic transcoder. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <!-- Opt-in observability only (../compose.yaml's `observability` profile):
         auto-instruments quarkus-rest AND quarkus-grpc. Fails soft with no
         collector listening, exactly like Ch18's leaner stack. -->
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-opentelemetry</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}</finalName>
    <plugins>
      <plugin>
        <groupId>${quarkus.platform.group-id}</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
