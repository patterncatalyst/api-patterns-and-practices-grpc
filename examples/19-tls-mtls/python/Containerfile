# Ch19 tls-mtls — Python, UBI 10, uv-managed, grpc.aio server over TLS/mTLS.
# Build (from the REPO ROOT, so this context can reach contracts/):
#   docker build -f examples/19-tls-mtls/python/Containerfile \
#     -t ch19-routing-python .
# compose.yaml sets the build context to the repo root so this Containerfile
# can COPY the two proto files this service needs straight from
# contracts/proto/ (the single source of truth), then run
# `python -m grpc_tools.protoc` to generate the shipping.* stub packages the
# app imports.
#
# UBI 10 publishes only the -minimal Python image (no ubi10/python-312).
# Pin: registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791464217
# Re-check with:
#   skopeo list-tags docker://registry.access.redhat.com/ubi10/python-314-minimal
# and confirm with `skopeo inspect`. Bump deliberately.

# ── Stage 1: Build ──────────────────────────────────────────
FROM registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791464217 AS build

# The image runs as UID 1001; the build stage needs root to write /app.
# Build at the same path the runtime uses: a venv is not relocatable, its
# console scripts carry the absolute interpreter path.
USER 0
WORKDIR /app

RUN pip install --no-cache-dir uv==0.12.24

COPY examples/19-tls-mtls/python/pyproject.toml ./
COPY examples/19-tls-mtls/python/app ./app

# No uv.lock committed yet (small, pure-Python dependency set); --locked is
# adopted once a lockfile lands alongside a persistence layer.
# `--group dev` pulls in grpcio-tools (needed below, not at runtime).
RUN uv sync --group dev

# Stage the two proto files this service needs, preserving the package path
# routing.proto's import statement expects, then generate the stub packages
# into /app/generated — a sibling of app/, added to PYTHONPATH below, so
# `from shipping.routing.v1 import routing_pb2` resolves the same way it
# does after a local (non-container) `protoc` run.
COPY contracts/proto/shipping/type/v1/types.proto ./proto/shipping/type/v1/types.proto
COPY contracts/proto/shipping/routing/v1/routing.proto ./proto/shipping/routing/v1/routing.proto
RUN mkdir -p generated && \
    .venv/bin/python -m grpc_tools.protoc -I proto \
      --python_out=generated --grpc_python_out=generated \
      proto/shipping/type/v1/types.proto proto/shipping/routing/v1/routing.proto

# Rebuild the venv without the dev group (grpcio-tools and its protoc
# binary are not needed to run the server).
RUN rm -rf .venv && uv sync --no-dev

# ── Stage 2: Runtime ────────────────────────────────────────
FROM registry.access.redhat.com/ubi10/python-314-minimal:10.2-1791464217

WORKDIR /app

COPY --from=build --chown=1001:0 /app/.venv /app/.venv
COPY --from=build --chown=1001:0 /app/app /app/app
COPY --from=build --chown=1001:0 /app/generated /app/generated

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/generated:/app" \
    PYTHONUNBUFFERED=1 \
    GRPC_HOST=0.0.0.0 \
    GRPC_PORT=9000 \
    CERTS_DIR=/certs

EXPOSE 9000
USER 1001

# certgen's output is world-readable (see certgen/gen-certs.sh's trailing
# `chmod 644`), so UID 1001 can read /certs/{server.crt,server.key,ca.crt}
# despite not owning the named volume's contents (they're written by
# certgen, which runs as root).
ENTRYPOINT ["python", "-m", "app.main"]
