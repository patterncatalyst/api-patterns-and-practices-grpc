   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Server-side interceptor chain, registration order: global interceptors before service-specific ones",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Server-side interceptor chain, registration order: global interceptors before service-specific ones",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t1458938359",
   "type": "text",
   "x": 20,
   "y": 215,
   "width": 883.3000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1230034191,
   "versionNonce": 854246680,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Quarkus: the ServerCall itself is wrapped (ForwardingServerCall) so close(status, trailers) logs whatever status the handler actually closes with.",
   "fontSize": 11,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Quarkus: the ServerCall itself is wrapped (ForwardingServerCall) so close(status, trailers) logs whatever status the handler actually closes with.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "t1346198328",
   "type": "text",
   "x": 20,
   "y": 232,
   "width": 883.3000000000001,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#1d1d1d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
